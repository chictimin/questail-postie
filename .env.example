# 필수는 아님. 없음으면 로컬 폴백 또는 요약 스킵 모드로 동작한다.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
MODEL=gpt-4o-mini

# 디스코드 발행용. 없으면 output/latest.md 저장만 수행한다.
DISCORD_WEBHOOK_URL=

# Steam 자동 연동용. sniff에서 입력·저장하면 보유 게임이 library_appids에 반영된다.
# 뉴스 수집(공개 API·RSS)에는 키가 필요 없다.
STEAM_API_KEY=
STEAM_ID=
